{
 "family": "c",
 "scenarios": [
  {
   "name": "c-grapevine-20s-dropout-stale",
   "summary": "Northbound over Tejon Pass, fixes stop for 20 s then resume; pill goes GPS? and recovers.",
   "suspect": false,
   "suspect_why": "",
   "script": [
    {
     "op": "start"
    },
    {
     "op": "drive",
     "from_mile": 200,
     "to_mile": 205,
     "mph": 65,
     "every_s": 5
    },
    {
     "op": "dropout",
     "secs": 20
    },
    {
     "op": "drive",
     "from_mile": 205.4,
     "to_mile": 208,
     "mph": 65,
     "every_s": 5
    }
   ],
   "expect": [
    {
     "after_op": 1,
     "at": "0.5",
     "state": {
      "mode": "gps",
      "off_route": false,
      "mile": [
       202.5,
       1.5
      ],
      "dir": "N",
      "stale": false,
      "pill": "GPS"
     },
     "why": "onFix on-route branch, heading at speed votes N via dirFromHeading"
    },
    {
     "after_op": 2,
     "state": {
      "stale": true,
      "pill": "GPS?",
      "status_re": "waiting for a gps signal",
      "mile": [
       205,
       1.5
      ]
     },
     "why": "5 s interval sets S.gpsStale when Date.now()-lastGoodT > STALE_MS 15 s; render shows GPS?"
    },
    {
     "after_op": 3,
     "state": {
      "stale": false,
      "pill": "GPS",
      "mile": [
       208,
       1.5
      ],
      "off_route": false
     },
     "why": "onFix clears S.gpsStale on next good fix"
    }
   ]
  },
  {
   "name": "c-canyon-3min-gap-jump-ahead",
