   "suspect": false,
   "suspect_why": "",
   "script": [
    {
     "op": "start"
    },
    {
     "op": "drive",
     "from_mile": 715,
     "to_mile": 722,
     "mph": 60,
     "every_s": 5
    },
    {
     "op": "dropout",
     "secs": 180
