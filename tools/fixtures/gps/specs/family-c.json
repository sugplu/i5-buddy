  {
   "name": "c-grapevine-fuzzy-blips-precise",
   "summary": "Grapevine northbound with alternating good and 300-2000 m fixes; two >1500 m in a row shows the precise notice, a good fix hides it.",
   "suspect": false,
   "suspect_why": "",
   "script": [
    {
     "op": "start"
    },
    {
     "op": "drive",
     "from_mile": 207,
     "to_mile": 210,
     "mph": 60,
     "every_s": 5
    },
    {
     "op": "fix",
     "lat": 34.8746,
     "lon": -118.8919,
     "acc": 400,
     "speed_mph": 60
    },
    {
     "op": "fix",
     "lat": 34.879,
     "lon": -118.8975,
     "acc": 2000,
     "speed_mph": 60
    },
    {
     "op": "fix",
     "lat": 34.8805,
     "lon": -118.8987,
     "acc": 1800,
     "speed_mph": 60
    },
    {
     "op": "hold",
     "secs": 5,
     "every_s": 5,
     "jitter_m": 0
    },
    {
     "op": "drive",
     "from_mile": 210.6,
     "to_mile": 213,
     "mph": 60,
     "every_s": 5
    }
   ],
   "expect": [
    {
     "after_op": 2,
     "state": {
      "mode": "gps",
      "mile": [
       210,
       1.5
      ],
      "off_route": false,
      "dir": "N"
     },
     "why": "coarse fix (acc > COARSE_M 250) still moves marker, votes no direction"
    },
    {
     "after_op": 4,
     "state": {
      "notices_include": [
       "precise"
      ],
      "mile": [
       210,
       1.5
      ]
     },
     "why": "onFix: accuracy>1500 ignored, ++fuzzyN>=2 -> showPrecise"
    },
    {
     "after_op": 6,
     "state": {
      "notices_exclude": [
       "precise"
      ],
      "mile": [
       213,
       1.5
      ],
      "off_route": false,
      "pill": "GPS"
     },
     "why": "good fix resets fuzzyN and hideNotice('precise')"
    }
   ]
  },
